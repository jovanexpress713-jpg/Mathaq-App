# Server
NODE_ENV=production
PORT=3000

# Persistent writable directory. Mount a persistent disk at this path in production.
MAZAQ_DATA_DIR=/var/lib/mazaq

# Required only when creating a new production database.
# Use a unique strong password; never commit the real value.
MAZAQ_INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Persistent writable directory for uploaded product/category images.
MAZAQ_UPLOADS_DIR=/var/lib/mazaq/uploads

# Comma-separated allowed browser origins for the Android/web client.
# Example: https://mazaq.example.com
MAZAQ_CORS_ORIGINS=
